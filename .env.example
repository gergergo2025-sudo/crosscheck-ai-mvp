# ============================================================
# CrossCheck AI 环境变量模板
# 复制为 .env 后填入真实密钥。API Key 是外部付费服务的运行时凭据，
# 按任务书约定：先搭骨架/开发，最后再统一配置密钥。
# ============================================================

# --- 模型 API（至少配置主模型 + 1 个副模型）---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# --- 事实搜索（事实验证器用，选 TAVILY / SERPER / BRAVE 之一）---
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_API_KEY=

# --- 代码沙箱（可先用本地 Docker，无需 key）---
E2B_API_KEY=

# --- 数学验证（MVP 可选）---
WOLFRAM_ALPHA_APP_ID=

# --- 嵌入（声明聚类用；默认随 OPENAI）---
# EMBEDDING_MODEL=text-embedding-3-small

# --- 应用配置 ---
# PostgreSQL is required for a successful durable query Report.  The health check
# remains available when this service is not reachable.
DATABASE_URL=postgresql+asyncpg://crosscheck:crosscheck@localhost:5432/crosscheck
REDIS_URL=redis://localhost:6379/0
# 并行调用的模型组合（逗号分隔）
CROSSCHECK_MODELS=gpt-4o,deepseek-chat
CROSSCHECK_ALLOWED_MODELS=
# Optional versioned prompt identifier (no secret values belong here).
PROMPT_VERSION=unified-v1
# 单次查询的模型调用成本上限（美元）
MAX_QUERY_COST_USD=0.5
# 相同问题缓存 TTL（秒）
CACHE_TTL_SECONDS=86400
